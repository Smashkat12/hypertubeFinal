# Copy to .env and fill in. start.sh loads it; .env is git-ignored.
MONGO_URI=mongodb://localhost:27017/Hypertube

# OAuth apps (redirect URIs: http(s)://<host>:5000|8443/oauth/<provider>/redirect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FORTY_TWO_CLIENT_ID=
FORTY_TWO_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# random strings, e.g. `openssl rand -hex 32`
SESSION_SECRET=
STREAM_TOKEN_SECRET=

# Email/password signups need a confirmation email. The mail account is dead, so new
# signups fail unless this is 1 (then anyone who can reach the app can register).
ALLOW_UNVERIFIED_SIGNUP=
